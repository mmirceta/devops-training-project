        <!-- ===== EDGES ===== -->

        <!-- Admin SSH to VM (via public IP, allowed from my IP) -->
        <mxCell id="e-admin-pip" parent="1" value="SSH :22 (my IP)" edge="1" source="ext-admin" target="dev-pip"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#00AA00;fontColor=#00AA00;fontSize=9;fontStyle=1;">
          <mxGeometry relative="1" as="geometry" />
