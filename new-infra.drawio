<mxfile host="app.diagrams.net">
  <diagram name="Azure Infrastructure" id="azure-infra-current">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== EXTERNAL ===== -->

        <mxCell id="ext-admin" parent="1" value="Admin" vertex="1"
          style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;">
