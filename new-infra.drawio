          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ACR PE to ACR (private connection) -->
        <mxCell id="e-acr-pe-acr" parent="1" value="private" edge="1" source="dev-acr-pe" target="dev-acr"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;dashed=1;fontSize=8;">
